{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": "../../",
    "baseUrl": "../../",
    "skipLibCheck": true,
    "moduleResolution": "node"
  },
  "include": [
    "./**/*.ts",
    "../../api/_lib/**/*.ts"
  ]
}
